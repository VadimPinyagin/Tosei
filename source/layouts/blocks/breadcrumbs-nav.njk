{% from "macros/breadcrumbs.njk" import breadcrumbs %}

{% if car %}
  {{ breadcrumbs([
    { name: "Главная", url: "index.html" },
    { name: "Каталог", url: "catalog.html" },
    { name: car.title, url: "#" }
  ]) }}
{% else %}
  {% set crumbs = [{ name: "Главная", url: "index.html" }] %}
  {% if parentTitle %}
    {% set crumbs = crumbs.concat([{ name: parentTitle }]) %}
  {% endif %}
  {% set crumbs = crumbs.concat([{ name: pageTitle }]) %}
  {{ breadcrumbs(crumbs) }}
{% endif %}
