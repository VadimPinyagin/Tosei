{% from "macros/fields.njk" import select, input, checkbox %}

<form class="form {{ mixClass }}" action="#" method="post">

  {% if formType == "filter" %}
    <ul>
      <li>{{ checkbox("Полная пошлина", "duty", true) }}</li>
      <li>{{ checkbox("Распил или констуктор", "dismantling", true) }}</li>
    </ul>
    <ul>
      <li>{{ select("Производитель", "brand", [{value: "not selected", text: "Не выбрано"}]) }}</li>
      <li>{{ select("Марка", "model", [{value: "not selected", text: "Не выбрано"}]) }}</li>
    </ul>


    <div class="form-group">
      <span class="form-group__label">Год выпуска</span>
      <ul class="form-group__select-wrapper">
        <li>{{ select("", "year_from", [{value: "year_from", text: "от"}]) }}</li>
        <li>{{ select("", "year_to", [{value: "year_to", text: "до"}]) }}</li>
      </ul>
    </div>
    <button class="search-form__button" type="submit">Показать авто</button>
  {% endif %}


  {% if formType == "callback" %}
    <h2 class="search-form__title">Оставить заявку</h2>

    {# Для второй формы нам нужны только 2 поля ввода #}
    {{ input("Ваше имя", "text", "user_name", "Введите имя") }}
    {{ input("Телефон", "tel", "user_phone", "+7 (___) ___-__-__") }}

    <button class="search-form__button" type="submit">Отправить</button>
  {% endif %}

</form>
