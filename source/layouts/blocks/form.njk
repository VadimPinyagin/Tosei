{% from "macros/fields.njk" import select, input, checkbox, button %}
<form class="form {{ mixClass }}" action="#" method="post">
  {% if formType == "filter" %}
    <fieldset class="{{ mixClass }}-module">
    <legend class="visually-hidden">Формат таможенного оформления</legend>
      <ul class="{{ mixClass }}-list">
        <li class="{{ mixClass }}-item">{{ checkbox("Полная пошлина", "duty", true, "intro__form") }}</li>
        <li class="{{ mixClass }}-item">{{ checkbox("Распил или конструктор", "dismantling", true, "intro__form" ) }}</li>
      </ul>
    </fieldset>
    <fieldset class="{{ mixClass }}-module">
    <legend class="visually-hidden">Автомобиль</legend>
    <ul class="{{ mixClass }}-list">
      <li>{{ select("Производитель", "brand", [{value: "not selected", text: "Не выбрано"}], "form") }}</li>
      <li>{{ select("Марка", "model", [{value: "not selected", text: "Не выбрано"}], "form") }}</li>
    </ul>
  </fieldset>
  <fieldset class="form__module">
    <legend class="form__module-legend">Год выпуска</legend>
      <ul class="form__module-list">
        <li>{{ select("", "year_from", [{value: "year_from", text: "от"}], "form__module")}}</li>
        <li>{{ select("", "year_to", [{value: "year_to", text: "до"}] , "form__module") }}</li>
      </ul>
  </fieldset>
  <ul class="form__action">
    <li class="form__action-item">{{ button("Расширенный поиск", "button", "form__module-extended") }}</li>
    <li class="form__action-item">{{ button("Показать авто", "submit", "form__module-submit") }}</li>
    <li class="form__actions-item form__actions-item--counter">
      <p class="form__action-counter">Автомобилей в наличии: <output class="form__action-value">256</output></p>
    </li>
  </ul>
  {% endif %}

    {% if formType == "callback" %}
    <fieldset class="form__module">
      <legend class="visually-hidden">Контактные данные для обратной связи</legend>
      <h2 class="form__title {% if formModifier %}form__title--{{ formModifier }}{% endif %}">Обратная связь</h2>
      <ul>
        <li>{{ input("Ваше имя", "text", "user_name", "Ввести", "form") }}</li>
        <li>{{ input("Контактный телефон", "tel", "user_phone", "+7", "form") }}</li>
      </ul>
    </fieldset>
    <button class="form__submit-btn {% if formModifier %}form__submit-btn--{{ formModifier }}{% endif %}" type="submit">Проконсультировать бесплатно</button>
  {% endif %}
</form>
