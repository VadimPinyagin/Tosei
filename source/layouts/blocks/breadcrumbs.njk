{% macro breadcrumbs(links) %}
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <ul class="breadcrumbs__list">
      {% for link in links %}
        <li class="breadcrumbs__item">
          {% if loop.last %}
            <!-- Последний элемент (текущая страница) делаем текстом, а не ссылкой -->
            <span class="breadcrumbs__link breadcrumbs__link--current" aria-current="page">{{ link.name }}</span>
          {% else %}
            <a class="breadcrumbs__link" href="{{ link.url }}">{{ link.name }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endmacro %}
