{% from "macros/components.njk" import sectionTitle, dlRow, pictureResponsive %}
{% from "macros/btn.njk" import button %}
{% from "macros/button-tab.njk" import tabButton %}
{% from "macros/review-card.njk" import reviewCard %}

<section class="product-info">
  <div class="product-info__inner container">
    <div class="product-info__header">
      {{ sectionTitle(car.title, mixClass="product-info__title", visuallyHidden=false) }}
      <dl class="product-info__info">
        {{ dlRow("Статус автомобиля", car.statusText, "product-info__info", modifier=car.status, visuallyHidden=true, isStatus=true) }}
      </dl>
    </div>

    <div class="product-info__gallery swiper">
      <ul class="product-info__wrapper swiper-wrapper">
        {% for img in car.productImages %}
          <li class="product-info__slide swiper-slide">
            {{ pictureResponsive({ image: img.src, title: img.alt }, car.folder, car.width, car.height, className="product-info__image") }}
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="product-info__tabs" role="tablist" aria-label="Характеристики и информация о товаре">
      {{ tabButton("Характеристики", "specs", isActive=true) }}
      {{ tabButton("Дополнительная информация", "additional", isActive=false) }}
      {{ tabButton("Видеообзор", "video-review", isActive=false) }}
    </div>

    <!-- Таб 1: Характеристики (теперь все данные плоские и лежат прямо в car) -->
    <div class="product-info__content is-active" id="specs" role="tabpanel" tabindex="0" aria-labelledby="tab-specs">
      <dl class="product-info__info">
        {{ dlRow("Производитель", car.manufacturer, "product-info__info") }}
        {{ dlRow("Тип", car.type, "product-info__info") }}
        {{ dlRow("Тип кузова", car.bodyType, "product-info__info") }}
        {{ dlRow("Год", car.year, "product-info__info") }}
        {{ dlRow("Пробег", car.mileage, "product-info__info") }}
        {{ dlRow("Двигатель", car.engine, "product-info__info") }}
        {{ dlRow("Мощность", car.power, "product-info__info") }}
        {{ dlRow("КПП", car.transmission, "product-info__info") }}
        {{ dlRow("Привод", car.drive, "product-info__info") }}
        {{ dlRow("Тип оформления", car.customs, "product-info__info", modifier="full", visuallyHidden=true) }}
        {{ dlRow("Аукцион", car.auction, "product-info__info") }}
        {{ dlRow("Дата аукциона", car.auctionDate, "product-info__info") }}
        {{ dlRow("Местонахождение", car.location, "product-info__info") }}
      </dl>
    </div>
    <div class="product-info__content" id="additional" role="tabpanel" tabindex="0" aria-labelledby="tab-additional">
      <div class="product-description">
        {% for text in car.descriptionParagraphs %}
          <p class="product-description__text">{{ text }}</p>
        {% endfor %}
      </div>
    </div>
    <div class="product-info__content" id="video-review" role="tabpanel" tabindex="0" aria-labelledby="tab-video-review">
      {{ reviewCard(data=car.videoReview, modClass="review-card--product") }}
    </div>

    <div class="product-info__purchase">
      <dl class="product-info__price-block">
        {{ dlRow(car.priceLabel, car.priceValue, "product-info__info") }}
      </dl>
      <div class="product-info__actions">
        {{ button("Консультация бесплатно", type="button", className="btn--consultation") }}
        {{ button("Оставить заявку", type="button", className="btn--order") }}
      </div>
    </div>
  </div>
</section>
