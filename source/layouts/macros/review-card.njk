{% from "macros/components.njk" import pictureResponsive %}

{% macro reviewCard(data, className="review-card", folder="review-images", width="202", height="") %}
<article class="{{ className }}">
  <a class="{{ className }}__media" href="{{ data.videoUrl if data.videoUrl else '#' }}" target="_blank" rel="noopener" aria-label="Смотреть видео отзыв от {{ data.author }}">
    {{ pictureResponsive(data, folder, width=width, height=height, desktopWidth="270", desktopHeight="160", tabletDesktop=true, className=className + "__image") }}
  </a>
  <ul class="{{ className }}__rating">
    {% for i in range(0, 5) %}
      <li class="{{ className }}__rating-item{% if i < data.rating %} {{ className }}__rating-item--active{% endif %}"></li>
    {% endfor %}
  </ul>
  <h3 class="{{ className }}__author">{{ data.author }}</h3>
  <p class="{{ className }}__car">{{ data.car }}</p>
</article>
{% endmacro %}
