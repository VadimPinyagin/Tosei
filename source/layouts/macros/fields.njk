{% macro select(label, name, options, className="") %}
    {% if label %}
      <label class="{{ className }}-label {{ className }}-label--select" for="field-{{ name }}">
        {{ label }}
      </label>
    {% endif %}
    <select class="{{ className }}-select" id="field-{{ name }}" name="{{ name }}"
      {% if not label %} aria-label="{{ name }}"{% endif %}>
      {% for option in options %}
        <option value="{{ option.value }}" {% if option.disabled %}disabled{% endif %}{% if option.selected %}selected{% endif %}>
          {{ option.text }}
        </option>
      {% endfor %}
    </select>
{% endmacro %}

{% macro input(label, type="text", name="", placeholder="", className="") %}
  <label class="{{ className }}__label" for="input-{{ name }}">{{ label }}</label>
  <input class="{{ className }}__input" type="{{ type }}" name="{{ name }}" id="input-{{ name }}" placeholder="{{ placeholder }}">
{% endmacro %}

{% macro checkbox(label, name, checked=false, className="") %}
  <input class="{{ className }}-checkbox" type="checkbox" name="{{ name }}" id="check-{{ name }}" {% if checked %}checked{% endif %}>
  <label class="{{ className }}-label {{ className }}-label--checkbox" for="check-{{ name }}">{{ label }}</label>
{% endmacro %}

{% macro radio(label, name, value, checked=false, className="") %}
  <input class="{{ className }}-input" type="radio" id="radio-{{ name }}-{{ value }}" name="{{ name }}" value="{{ value }}" {% if checked %}checked{% endif %}>
  <label class="{{ className }}-label" for="radio-{{ name }}-{{ value }}">{{ label }}</label>
{% endmacro %}

{% macro dlRow(term, value, className, modifier="", visuallyHidden=false, isStatus=false) %}
  <div class="{{ className }}-row {% if modifier %}{{ className }}-row--{{ modifier }}{% endif %}">
    <dt class="{% if visuallyHidden %}visually-hidden{% else %}{{ className }}-term{% endif %} {% if modifier and not visuallyHidden %}{{ className }}-term--{{ modifier }}{% endif %}">
      {{ term }}
    </dt>
    <dd class="{% if isStatus %}{{ className | replace('__info', '') }}__status {{ className | replace('__info', '') }}__status--{{ modifier }}{% else %}{{ className }}-value {% if modifier %}{{ className }}-value--{{ modifier }}{% endif %}{% endif %}">
      {{ value }}
    </dd>
  </div>
{% endmacro %}



