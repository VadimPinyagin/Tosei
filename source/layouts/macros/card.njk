{% from "macros/fields.njk" import dlRow %}

{% macro card(data, className="") %}
  <a class="{{ className }}" href="#">
    <h3 class="{{ className }}__title">{{ data.title }}</h3>
    <picture>
      <source type="image/webp" media="(min-width: 1440px)" srcset="img/{{ data.image }}-desktop.webp 1x, img/{{ data.image }}-desktop@2x.webp 2x">
      <source type="image/jpeg" media="(min-width: 1440px)" srcset="img/{{ data.image }}-desktop.jpg 1x, img/{{ data.image }}-desktop@2x.jpg 2x">
      <source type="image/webp" srcset="img/{{ data.image }}-mobile.webp 1x, img/{{ data.image }}-mobile@2x.webp 2x">
      <img class="{{ className }}__image" src="img/{{ data.image }}-mobile.jpg" srcset="img/{{ data.image }}-mobile@2x.jpg 2x" width="{{ data.width }}" height="{{ data.height }}" alt="{{ data.title }}">
    </picture>
    <dl class="{{ className }}__description">
      {{ dlRow("Объем двигателя", data.engine, className + "__description") }}
      {{ dlRow("Год", data.year, className + "__description") }}
      {{ dlRow("Пробег", data.mileage, className + "__description") }}
      {{ dlRow("Тип оформления", data.customs, className + "__description", modifier="full", visuallyHidden=true) }}
      {{ dlRow("Привод", data.drive, className + "__description") }}
      {{ dlRow("КПП", data.transmission, className + "__description") }}
      {{ dlRow(data.priceLabel, data.priceValue, className + "__description", modifier="price", visuallyHidden=true) }}
      {{ dlRow("Статус автомобиля", data.statusText, className + "__description", modifier=data.status, visuallyHidden=true) }}
    </dl>
  </a>
{% endmacro %}

