{% macro card(data, className="") %}
<a class="{{ className }} card" href="#">
  <h3 class="{{ className }}__title">{{ data.title }}</h3>
  <picture>
    <source type="image/webp" media="(min-width: 1440px)" srcset="img/{{ data.image }}-desktop.webp 1x, img/{{ data.image }}-desktop@2x.webp 2x">
    <source type="image/jpeg" media="(min-width: 1440px)" srcset="img/{{ data.image }}-desktop.jpg 1x, img/{{ data.image }}-desktop@2x.jpg 2x">
    <source type="image/webp" srcset="img/{{ data.image }}-mobile.webp 1x, img/{{ data.image }}-mobile@2x.webp 2x">
    <img class="{{ className }}__image" src="img/{{ data.image }}-mobile.jpg" srcset="img/{{ data.image }}-mobile@2x.jpg 2x" width="{{ data.width }}" height="{{ data.height }}" alt="{{ data.title }}">
  </picture>
</a>
{% endmacro %}
