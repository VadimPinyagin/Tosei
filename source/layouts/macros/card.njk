{% from "macros/components.njk" import dlRow, pictureResponsive %}

{% macro card(data, className="") %}
  <a class="{{ className }}" href="product-{{ data.id }}.html" data-title="{{ data.title }}">
    <h3 class="{{ className }}__title">{{ data.title }}</h3>
    {{ pictureResponsive({ image: data.coverImage, title: data.title }, data.folder, data.width, data.height, className=className + "__image") }}
    <dl class="{{ className }}__info">
      {{ dlRow("Объем двигателя", data.engine, className + "__info") }}
      {{ dlRow("Год", data.year, className + "__info") }}
      {{ dlRow("Пробег", data.mileage, className + "__info") }}
      {{ dlRow("Тип оформления", data.customs, className + "__info", modifier="full", visuallyHidden=true) }}
      {{ dlRow("Привод", data.drive, className + "__info") }}
      {{ dlRow("КПП", data.transmission, className + "__info") }}
      {{ dlRow(data.priceLabel, data.priceValue, className + "__info", modifier="price", visuallyHidden=false) }}
      {{ dlRow("Статус автомобиля", data.statusText, className + "__info", modifier=data.status, visuallyHidden=true, isStatus=true) }}
    </dl>
  </a>
{% endmacro %}
