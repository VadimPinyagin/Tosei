{% from "macros/fields.njk" import select, input, checkbox %}
{% from "macros/btn.njk" import button %}
{% from "macros/components.njk" import sectionTitle %}

{% macro renderForm(formType, mixClass="") %}
<form class="{{ mixClass }} form" action="#" method="post">
  {% if formType == "filter" %}
    <fieldset class="form__module">
      <legend class="visually-hidden">Формат таможенного оформления</legend>
      <ul class="form__list">
        <li class="form__list-item">
          {{ checkbox("Полная пошлина", "duty", true, "form__module") }}
        </li>
        <li class="form__list-item">
          {{ checkbox("Распил или конструктор", "dismantling", true, "form__module") }}
        </li>
      </ul>
    </fieldset>
    <fieldset class="form__module">
      <legend class="visually-hidden">Автомобиль</legend>
      <ul class="form__list">
        <li class="form__list-item">
          {{ select("Производитель", "brand", [{value: "not selected", text: "Не выбрано"}], "form__module") }}
        </li>
        <li class="form__list-item">
          {{ select("Марка", "model", [{value: "not selected", text: "Не выбрано"}], "form__module") }}
        </li>
      </ul>
    </fieldset>
    <fieldset class="form__module">
      <legend class="form__legend">Год выпуска</legend>
      <ul class="form__list form__list--range">
        <li class="form__list-item">
          {{ select("", "year_from", [{value: "year_from", text: "от"}], "form__module") }}
        </li>
        <li class="form__list-item">
          {{ select("", "year_to", [{value: "year_to", text: "до"}], "form__module") }}
        </li>
      </ul>
    </fieldset>
    <ul class="form__action">
      <li class="form__action-item">
        {{ button("Расширенный поиск", "button", "form__btn btn--extended") }}
      </li>
      <li class="form__action-item">
        {{ button("Найти", "submit", "form__btn btn--search") }}
      </li>
      <li class="form__action-item form__action-item--counter">
        <p class="form__counter">
          <span>Автомобилей в наличии:</span>
          <output class="form__counter-value">256</output>
        </p>
      </li>
    </ul>
  {% endif %}
  {% if formType == "callback" %}
    <fieldset class="form__module form__module--callback">
      <legend class="visually-hidden">Контактные данные для обратной связи</legend>
      {{ sectionTitle("Обратная связь", "contacts__form-title") }}
      <ul class="form__list form__list--callback">
        <li class="form__list-item form__list-item--callback">
          {{ input("Ваше имя", "text", "user_name", "Ввести", "form") }}
        </li>
        <li class="form__list-item form__list-item--callback">
          {{ input("Контактный телефон", "tel", "user_phone", "+7", "form") }}
        </li>
      </ul>
    </fieldset>
    {{ button("Проконсультировать бесплатно", "submit", "form__btn btn--submit") }}
  {% endif %}
</form>
{% endmacro %}
