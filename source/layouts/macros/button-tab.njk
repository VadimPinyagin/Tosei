{% macro tabButton(text, targetId, isActive=false, className="product-info", hasDataAttr=false) %}
  <button
    class="{{ className }}__tab swiper-slide {% if isActive %}is-active{% endif %}"
    {% if hasDataAttr %}data-tab-slide{% endif %}
    type="button"
    role="tab"
    aria-selected="{% if isActive %}true{% else %}false{% endif %}"
    aria-controls="{{ targetId }}"
    id="tab-{{ targetId }}"
    {% if not isActive %}tabindex="-1"{% endif %}>
    {{ text }}
  </button>
{% endmacro %}
